<div class="border rounded p-2" style="height: 15em; overflow-y: auto;">
    @if (History.Count == 0)
    {
        <div class="gdbv-text-sm text-muted">No queries run yet. Queries you run from the Query tab appear here.</div>
    }
    else
    {
        <div class="gdbv-text-xs text-muted mb-2">Last @History.Count run quer@(History.Count == 1 ? "y" : "ies"): click to load into the Query tab.</div>
        <div class="list-group list-group-flush">
            @foreach (var q in History)
            {
                var query = q;
                <button type="button" class="gdbv-text-sm font-monospace list-group-item list-group-item-action py-1 px-2 text-truncate" title="@query" @onclick="() => OnSelect.InvokeAsync(query)">
                    @query
                </button>
            }
        </div>
    }
</div>

@code {
    [Parameter] public IReadOnlyList<string> History { get; set; } = Array.Empty<string>();
    [Parameter] public EventCallback<string> OnSelect { get; set; }
}
