@inject IJSRuntime JS

@* The shell the AI popups sit in: a window rather than a modal. It does not dim the page, does not trap
   the pointer, and can be dragged by its header and resized from its corner, so a query can be edited
   and run with the assistant still open beside it.

   It is hidden with CSS instead of being removed, which is the whole reason a conversation survives
   closing the dialog: the content keeps its component state because it is never unmounted. *@

<div class="gdbv-dialog card shadow-lg @Class @(Visible ? "" : "d-none")" @ref="panel" style="width: @Width; @(Resizable ? $"height: {Height};" : $"max-height: {Height};")"
     role="dialog" aria-label="@Title" aria-hidden="@(Visible ? "false" : "true")">

    <div class="card-header gdbv-dialog-header d-flex align-items-center gap-2" @ref="handle">
        <span class="fw-semibold flex-grow-1">
            @if (TitleIcon != null)
            {
                <span class="gdbv-title-icon" aria-hidden="true">@TitleIcon</span>
            }
            else if (!string.IsNullOrEmpty(TitleGlyph))
            {
                <i class="bi @TitleGlyph gdbv-title-icon" aria-hidden="true"></i>
            }
            @Title
        </span>
        @HeaderContent
        <button type="button" class="btn-close" aria-label="Close" @onclick="OnClose"></button>
    </div>

    <div class="card-body d-flex flex-column overflow-auto">
        @ChildContent
    </div>

    @if (FooterContent != null)
    {
        @* Room at the right for the resize grip below, so a footer button never sits under it. *@
        <div class="card-footer d-flex justify-content-end gap-2" style="padding-right: 2.25rem;">
            @FooterContent
        </div>
    }

    @* Its own grip rather than the CSS one. A browser's native resizer is a few faint pixels with a hit
       area to match, which is neither findable nor easy to hit; this is drawn at a size worth aiming at. *@
    @if (Resizable)
    {
        <div class="gdbv-dialog-resize" @ref="grip" title="Drag to resize">
            <svg viewBox="0 0 16 16" width="15" height="15" fill="currentColor" aria-hidden="true">
                <path d="M14 9.5v4a.5.5 0 0 1-.5.5h-4a.5.5 0 0 1 0-1h2.793L9.146 9.854a.5.5 0 1 1 .708-.708L13 12.293V9.5a.5.5 0 0 1 1 0z" />
                <path d="M2 6.5v-4a.5.5 0 0 1 .5-.5h4a.5.5 0 0 1 0 1H3.707l3.147 3.146a.5.5 0 1 1-.708.708L3 3.707V6.5a.5.5 0 0 1-1 0z" />
            </svg>
        </div>
    }

</div>

@code {
    ///<summary>Whether the window is on screen. False hides it; it is never torn down, so its content keeps its state.</summary>
    [Parameter] public bool Visible { get; set; }

    [Parameter] public EventCallback OnClose { get; set; }

    [Parameter] public string Title { get; set; }

    ///<summary>Identifies the window to the geometry store, so each reopens where its own was left.</summary>
    [Parameter] public string StorageKey { get; set; }

    ///<summary>Opening size, used only until the window has been resized once.</summary>
    [Parameter] public string Width { get; set; } = "min(980px, 94vw)";

    [Parameter] public string Height { get; set; } = "min(780px, 90vh)";

    ///<summary>Extra controls for the title bar, to the left of the close button.</summary>
    [Parameter] public RenderFragment HeaderContent { get; set; }

    ///<summary>A small picture before the title: Ask AI's spark, the one on the button that opens it (2026-11-01, from GDS Viewer).</summary>
    [Parameter] public RenderFragment TitleIcon { get; set; }

    ///<summary>A Bootstrap icon before the title by its class, such as "bi-stars", when there is no TitleIcon: the icon of what opens the window (2026-11-04, the user).</summary>
    [Parameter] public string TitleGlyph { get; set; }

    ///<summary>A class of the window's own on its outermost element, for a window that is styled apart: Ask AI's.</summary>
    [Parameter] public string Class { get; set; }

    [Parameter] public RenderFragment ChildContent { get; set; }

    ///<summary>A button row along the bottom, or null for a window with none.</summary>
    [Parameter] public RenderFragment FooterContent { get; set; }

    ///<summary>
    ///Whether the corner grip is there. A window without it is the size its content asks for, up to its Height
    ///(as a max-height then), with as much room under its content as at its sides (Find coordinates, 2026-11-06, the user).
    ///</summary>
    [Parameter] public bool Resizable { get; set; } = true;

    private ElementReference panel;
    private ElementReference handle;
    private ElementReference grip;

    //Whether the window was on screen at the last render, so placement runs when it appears and not
    //on every render while it is open. It cannot run any earlier than that: measuring a d-none element
    //gives a zero-sized box, and centering that would put the window in the corner.
    private bool wasVisible;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (Visible == wasVisible)
            return;

        wasVisible = Visible;

        if (!Visible)
            return;

        //Attaching on each appearance rather than once is deliberate: it re-clamps a window whose saved
        //position is off the edge of a screen smaller than the one it was saved on, and raises it above
        //its peers so the one just opened is the one in front.
        try
        {
            object gripOrNone = null;

            if (Resizable)
                gripOrNone = grip;

            await JS.InvokeVoidAsync("floatingDialog.attach", panel, handle, gripOrNone, StorageKey);
        }
        catch { }
    }
}
