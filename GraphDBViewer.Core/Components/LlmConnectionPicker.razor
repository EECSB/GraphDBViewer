@using GraphDBViewerWeb.Code
@implements IDisposable
@inject LlmConnectionStore Store

@* The saved AI-model picker + its add/edit form, shared by every AI feature ("Ask AI" today, the
   knowledge-graph generator next) so a model configured once is offered everywhere. Owns the CRUD via
   LlmConnectionStore; the parent only learns which connection is picked, through SelectedChanged. *@

@* Picking and editing are separated on purpose: somewhere that only needs to choose a model shows a
   dropdown and nothing else, so the panel around it stays about the thing it is for. *@
@if (PickOnly)
{
    <select class="form-select form-select-sm"
            style="max-width: 260px;"
            value="@selectedKey"
            @onchange="OnSelectionChangedAsync"
            title="Which saved AI model answers. Models are added and edited under Settings → AI settings.">
        @if (connections.Count == 0)
        {
            <option value="">-- No model: add one in Settings --</option>
        }
        @foreach (var kv in connections)
        {
            <option value="@kv.Key">@kv.Key (@kv.Value.ProviderType)</option>
        }
    </select>
}
else
{
    @* The chosen model's name heads the picker and is renamed there (2026-11-04, the user), as a connection's is: the
       form under it is only the model's settings. *@
    <div class="mb-2">
        <SavedPicker @ref="picker"
                     TestId="llm-picker"
                     Items="PickerItems"
                     SelectedKey="@(isEditing ? selectedKey : null)"
                     Noun="model"
                     UnsavedName="@formName"
                     NamePlaceholder="e.g. Claude Opus"
                     AddTitle="Add an AI model"
                     Error="@nameError"
                     OnPick="PickAsync"
                     OnRename="RenameAsync"
                     OnDuplicate="DuplicateAsync"
                     OnDelete="DeleteAsync"
                     OnAdd="StartAdd">
        @* Joined to the picker it saves to, as a connection's is (2026-11-05, the user): orange while there is something
           to save. Picking the model again in the list puts back what is saved, in place of Cancel. *@
        <HeadEnd>
            <button class="btn btn-sm text-nowrap @(HasModelToSave ? "gdbv-btn-unsaved" : "btn-primary")" @onclick="SaveFormAsync" title="@(HasModelToSave ? "These settings have changes that are not saved. Save them to the model named in the picker" : "Save these settings to the model named in the picker")" data-testid="llm-form-save"><i class="bi bi-floppy me-1" aria-hidden="true"></i>Save</button>
        </HeadEnd>
    </SavedPicker>
    </div>
}

@if (showForm)
{
    <div class="card p-3 mb-3" data-testid="llm-form">
        @if (formError != null)
        {
            <div class="gdbv-text-sm text-danger mb-2 invalid-feedback d-block" data-testid="llm-form-error">@formError</div>
        }

        <div class="mb-2">
            <label class="form-label d-block">Provider</label>
            <div class="btn-group btn-group-sm" role="group" aria-label="Provider">
                <button type="button" class="btn @(form.ProviderType == "Anthropic" ? "btn-primary" : "btn-outline-primary")" @onclick='() => ChooseProvider("Anthropic")'>Anthropic</button>
                <button type="button" class="btn @(form.ProviderType == "OpenAI" ? "btn-primary" : "btn-outline-primary")" @onclick='() => ChooseProvider("OpenAI")'>OpenAI</button>
                <button type="button" class="btn @(form.ProviderType == "Gemini" ? "btn-primary" : "btn-outline-primary")" @onclick='() => ChooseProvider("Gemini")'>Gemini</button>
                <button type="button" class="btn @(form.ProviderType == "Custom" ? "btn-primary" : "btn-outline-primary")" @onclick='() => ChooseProvider("Custom")'>Other</button>
            </div>
            <div class="gdbv-text-xs form-text">Gemini = Google's free-tier models: get a key from Google AI Studio (aistudio.google.com). Other = any OpenAI-compatible server (Ollama, LM Studio, vLLM, Azure, self-hosted).</div>
        </div>

        @if (form.ProviderType != "Anthropic")
        {
            <div class="mb-2">
                <label class="form-label">
                    Base URL
                    @if (BaseUrlOptional)
                    {
                        <text>(optional)</text>
                    }
                    else
                    {
                        <span class="text-danger">*</span>
                    }
                </label>
                <input class="form-control" placeholder="@BaseUrlPlaceholder" @bind="form.BaseUrl" @bind:after="KeepTheSavedKeyToItsTransport" />
            </div>
        }

        <div class="mb-2 row">
            <div class="col">
                <label class="form-label">
                    Model
                    @if (ModelRequired)
                    {
                        <span class="text-danger">*</span>
                    }
                </label>
                @* Read as it is typed rather than when the box is left, as GDS Viewer's is: the note under the rates says what
                   is known of the model typed, and written on leaving the box it would move Save from under a press on it. *@
                <input class="form-control" placeholder="@ModelPlaceholder" @bind="form.Model" @bind:event="oninput" data-testid="llm-model" />
            </div>
            <div class="col">
                <label class="form-label">
                    API key
                    @if (ApiKeyRequired)
                    {
                        <span class="text-danger">*</span>
                    }
                </label>
                <input class="form-control" type="password" @bind="form.ApiKey" />
            </div>
            @* Only Anthropic sends a cap — the OpenAI-compatible adapter leaves it to the
               server, so the box would do nothing for the other providers. *@
            @if (SendsMaxTokens)
            {
                <div class="col-3">
                    <label class="form-label">Max tokens</label>
                    <input class="form-control" type="number" min="1" @bind="form.MaxTokens" title="Ceiling on the answer's length. It's a limit, not an allowance. You're billed for what the model actually writes, so raise it if a long answer stops mid-sentence." />
                </div>
            }
        </div>

        @* The model's own rates, in US dollars a million tokens (2026-11-02, GDS Viewer's): what Ask AI prices each answer
           and its estimates at. A blank box takes the published rate, shown grayed in it where there is one; a model with
           neither shows the tokens an answer took and no cost (AiPricing.For). *@
        <div class="mb-2" data-testid="llm-prices" title="What a million tokens cost on this model, in US dollars: read, read back from the provider's cache, and written. Blank uses the published rate where there is one">
            <label class="form-label">Price <span class="text-body-secondary gdbv-text-xs">$ per million tokens</span></label>

            <div class="d-flex flex-wrap gap-2">
                <div class="input-group input-group-sm" style="max-width: 10em;">
                    <span class="input-group-text">in</span>
                    <input class="form-control" type="number" min="0" step="any" placeholder="@PricePlaceholder(0)" @bind="form.InputPrice" data-testid="llm-price-input" aria-label="Input price" />
                </div>

                <div class="input-group input-group-sm" style="max-width: 10em;">
                    <span class="input-group-text">cached</span>
                    <input class="form-control" type="number" min="0" step="any" placeholder="@PricePlaceholder(1)" @bind="form.CachedPrice" data-testid="llm-price-cached" aria-label="Cached input price" />
                </div>

                <div class="input-group input-group-sm" style="max-width: 10em;">
                    <span class="input-group-text">out</span>
                    <input class="form-control" type="number" min="0" step="any" placeholder="@PricePlaceholder(2)" @bind="form.OutputPrice" data-testid="llm-price-output" aria-label="Output price" />
                </div>
            </div>

            @if (priceError != null)
            {
                <div class="gdbv-text-xs text-danger" data-testid="llm-price-error">@priceError</div>
            }

            <div class="gdbv-text-xs form-text" data-testid="llm-price-note">@PriceNote()</div>
        </div>

        @* A PDF read into words in the page before it is sent (2026-11-02, the user's): for a model that cannot read the file,
           a server of one's own or Gemini, or to spend less. Off until ticked, as the file is what reads best where it can go. *@
        <div class="form-check mb-2" title="Read a PDF's words out of it in this page, with PdfPig, and send those in place of the file. For a model that cannot read a PDF, or to spend less. A scan has no words to read, so it needs this off and a model that reads PDFs">
            <input class="form-check-input" type="checkbox" id="llm-pdf-as-text" @bind="form.PdfAsText" data-testid="llm-pdf-as-text" />
            <label class="form-check-label" for="llm-pdf-as-text">Send PDFs as their text</label>
        </div>

        @*The key saved with a model goes only to an address as encrypted as the one it was saved for (the user's rule
          of 2026-10-03): an http base URL takes it out of the form until it is typed again.*@
        @if (savedKey.Says(form.ApiKey))
        {
            <div class="gdbv-text-sm text-warning mb-2" data-testid="llm-key-held-back">
                The key saved with this model was given for an encrypted address, so it is not sent or saved for this one,
                which is not. Type it again to use it here, or give the address https and it comes back.
            </div>
        }
    </div>
}

@code {
    ///<summary>
    ///Show the dropdown alone — no add / delete / edit, and no form. For a panel that needs to know which
    ///model to use but is not the place to manage them; with none saved, the dropdown says where to add one.
    ///</summary>
    [Parameter] public bool PickOnly { get; set; }

    ///<summary>Raised whenever the picked connection changes — on load, selection, save and delete.
    ///Null means no models exist. The parent generates with what this hands it.</summary>
    [Parameter] public EventCallback<LlmConnection> SelectedChanged { get; set; }

    private Dictionary<string, LlmConnection> connections = new();
    private string selectedKey;

    //Add / edit form state.
    private bool showForm;
    private bool isEditing;
    private string formName;
    private string originalName;
    private LlmConnection form = new();
    private string formError;

    private SavedPicker picker;

    ///<summary>
    ///Whether Save has anything to do, which it shows in orange (2026-11-05, the user): the form differs from the model
    ///chosen, or, with none chosen, a name was typed or the form differs from a blank one. Undoing a change takes it away.
    ///</summary>
    private bool HasModelToSave
    {
        get
        {
            if (isEditing)
            {
                var saved = Selected;

                return saved != null && !form.SameSettings(saved);
            }

            return !string.IsNullOrWhiteSpace(formName) || !form.SameSettings(new LlmConnection());
        }
    }

    ///<summary>Why the name in the picker's head was not taken, under it until the next name or Save.</summary>
    private string nameError;

    ///<summary>The saved models as the picker lists them, by name.</summary>
    private IReadOnlyList<SavedPickerItem> PickerItems
    {
        get
        {
            var items = new List<SavedPickerItem>();

            foreach (var key in connections.Keys)
                items.Add(new SavedPickerItem(key, key));

            return items;
        }
    }

    ///<summary>
    ///The key the model in the form was saved with, held back while the form's address is not encrypted
    ///(<see cref="SavedSecretRule"/>): an http base URL on a model saved at an https one takes it out of the form, so
    ///Save neither sends nor keeps it unless it is typed again.
    ///</summary>
    private readonly SavedSecretRule savedKey = new();

    private void KeepTheSavedKeyToItsTransport()
    {
        form.ApiKey = savedKey.Keep(form.ApiKey, LlmConnection.Encrypts(form));
    }

    ///<summary>Another provider is another address, and may be one without TLS.</summary>
    private void ChooseProvider(string providerType)
    {
        form.ProviderType = providerType;

        KeepTheSavedKeyToItsTransport();
    }

    private LlmConnection Selected
    {
        get
        {
            if (!string.IsNullOrEmpty(selectedKey) && connections.TryGetValue(selectedKey, out var c))
                return c;

            return null;
        }
    }

    private string ModelPlaceholder
    {
        get
        {
            //Anthropic is the one provider whose model is optional (see ModelRequired), so its placeholder
            //has to name the model a blank field actually runs — and it reads that from the provider, so the
            //two can't drift apart again. The others are required fields, where the placeholder is only an
            //example of what to type.
            if (form.ProviderType == "Anthropic")
                return $"{AnthropicProvider.DefaultModel} (default)";
            else if (form.ProviderType == "OpenAI")
                return "gpt-4o-mini";
            else if (form.ProviderType == "Gemini")
                return "gemini-2.5-flash";

            return "model name";
        }
    }

    ///<summary>Why the rates typed were not saved, under them until the next Save.</summary>
    private string priceError;

    ///<summary>The published rate a blank price box stands for, input, cached or output, or nothing where none is known.</summary>
    private string PricePlaceholder(int which)
    {
        if (AiPricing.PublishedFor(AiPricing.ModelOf(form), form.ProviderType, DateTime.UtcNow) is not LlmPrice published)
            return "";

        var rate = published.Output;

        if (which == 0)
            rate = published.Input;
        else if (which == 1)
            rate = published.Cached;

        return rate.ToString("0.00##", System.Globalization.CultureInfo.InvariantCulture);
    }

    ///<summary>Under the rates: where a blank box's rate comes from, or that there is none.</summary>
    private string PriceNote()
    {
        var model = AiPricing.ModelOf(form);

        if (model.Length == 0)
            return "";

        if (AiPricing.PublishedFor(model, form.ProviderType, DateTime.UtcNow) != null)
            return $"Grayed: {model}'s published rates, read {AiPricing.ReadOn}. Leave a box blank to use them.";

        return $"No published rate is known here for {model}. Without one, the AI window shows the tokens an answer took and no cost.";
    }

    //Gemini and OpenAI have a sensible default endpoint, so the Base URL is optional; a custom server needs one.
    private bool BaseUrlOptional => form.ProviderType == "OpenAI" || form.ProviderType == "Gemini";

    //An API key is required for the hosted providers; a local OpenAI-compatible server ("Other") may not need one.
    private bool ApiKeyRequired => form.ProviderType != "Custom";

    //Every provider needs a model id except Anthropic, which falls back to a built-in default.
    private bool ModelRequired => form.ProviderType != "Anthropic";

    //Only the Anthropic adapter sends an output cap; the OpenAI-compatible one lets the server decide.
    private bool SendsMaxTokens => form.ProviderType == "Anthropic";

    private string BaseUrlPlaceholder
    {
        get
        {
            if (form.ProviderType == "Gemini")
                return OpenAiProvider.GeminiBaseUrl;
            else if (form.ProviderType == "Custom")
                return "http://localhost:11434/v1";

            return OpenAiProvider.DefaultBaseUrl;
        }
    }

    protected override async Task OnInitializedAsync()
    {
        Store.Changed += OnStoreChangedAsync;

        connections = await Store.LoadAsync();
        selectedKey = connections.Keys.FirstOrDefault();

        if (!PickOnly)
            ShowSelectedInForm();

        await NotifySelectedAsync();
    }

    public void Dispose()
    {
        Store.Changed -= OnStoreChangedAsync;
    }

    ///<summary>
    ///Another picker saved. Reload, and keep the selection if what was selected is still there — the one
    ///that did the editing has already moved its own selection, and moving it a second time would undo
    ///that. A selection that no longer exists falls back to whatever does.
    ///</summary>
    private async Task OnStoreChangedAsync()
    {
        connections = await Store.LoadAsync();

        if (selectedKey == null || !connections.ContainsKey(selectedKey))
            selectedKey = connections.Keys.FirstOrDefault();

        //Only when this picker is not mid-edit: reloading the form under somebody's hands would throw
        //away what they are typing because a different panel saved something.
        if (!PickOnly && !showForm)
            ShowSelectedInForm();

        await NotifySelectedAsync();
        await InvokeAsync(StateHasChanged);
    }

    private async Task NotifySelectedAsync()
    {
        await SelectedChanged.InvokeAsync(Selected);
    }

    private async Task OnSelectionChangedAsync(ChangeEventArgs e)
    {
        selectedKey = e.Value?.ToString();

        await NotifySelectedAsync();
    }

    ///<summary>
    ///Loads the selected model into the form, or closes the form when there is nothing selected.
    ///
    ///This is the whole of what the Edit button used to do. The settings of the model you have chosen are
    ///not a separate mode worth a button — they are what this panel is for — so they are simply shown.
    ///</summary>
    private void ShowSelectedInForm()
    {
        var selected = Selected;

        //With none saved, the panel is the form for the first one.
        if (selected == null)
        {
            StartAdd();

            return;
        }

        isEditing = true;
        form = new LlmConnection(selected);
        savedKey.Remember(selected.ApiKey, LlmConnection.Encrypts(selected));
        formName = selected.Name;
        originalName = selected.Name;
        formError = null;
        nameError = null;
        priceError = null;
        showForm = true;
    }

    ///<summary>New: a blank form, and its name typed in the picker's head.</summary>
    private void StartAdd()
    {
        isEditing = false;
        form = new LlmConnection();
        savedKey.Remember(null, false);
        formName = string.Empty;
        originalName = null;
        formError = null;
        nameError = null;
        priceError = null;
        showForm = true;
    }

    private async Task PickAsync(string key)
    {
        selectedKey = key;

        ShowSelectedInForm();

        await NotifySelectedAsync();
    }

    ///<summary>
    ///A name typed in the picker's head, answered with why it was refused or null. The picker asks through a plain
    ///delegate, to hear the answer, and that redraws nothing here, so this does.
    ///</summary>
    private async Task<string> RenameAsync(string key, string name)
    {
        var refused = await RenameModelAsync(key, name);

        StateHasChanged();

        return refused;
    }

    ///<summary>
    ///For the model being added the name is only its name until Add; a saved one is renamed at once, where it is in the
    ///list, keeping any edits in the form below.
    ///</summary>
    private async Task<string> RenameModelAsync(string key, string name)
    {
        nameError = null;

        if (key == null)
        {
            formName = name;
            return null;
        }

        if (connections.ContainsKey(name))
        {
            nameError = "A model with that name already exists.";
            return nameError;
        }

        connections = SavedPickerItem.Renamed(connections, key, name);
        connections[name].Name = name;

        if (selectedKey == key)
            selectedKey = name;

        //Only the form of the model renamed: one being added keeps the name typed for it.
        if (isEditing && originalName == key)
        {
            formName = name;
            originalName = name;
            form.Name = name;
        }

        await Store.SaveAsync(connections);
        await NotifySelectedAsync();

        return null;
    }

    ///<summary>A copy of a saved model, right after it, and chosen: what to change for a second one like it.</summary>
    private async Task DuplicateAsync(string key)
    {
        if (!connections.TryGetValue(key, out var original))
            return;

        var name = SavedPickerItem.CopyName(key, connections.Keys);
        var copy = new LlmConnection(original) { Name = name };

        connections = SavedPickerItem.InsertedAfter(connections, key, name, copy);
        selectedKey = name;

        ShowSelectedInForm();

        await Store.SaveAsync(connections);
        await NotifySelectedAsync();
    }

    private async Task SaveFormAsync()
    {
        formError = null;
        nameError = null;

        var name = formName?.Trim();

        if (string.IsNullOrEmpty(name))
        {
            nameError = "Name the model first.";
            picker?.BeginRename();

            return;
        }

        if ((!isEditing || name != originalName) && connections.ContainsKey(name))
        {
            nameError = "A model with that name already exists.";
            picker?.BeginRename();

            return;
        }

        //A server of one's own has no address but this one, and is sent nothing without it (OpenAiProvider.NoAddress).
        if (form.ProviderType == "Custom" && string.IsNullOrWhiteSpace(form.BaseUrl))
        {
            formError = "Base URL is required for a server of your own.";
            return;
        }

        if (form.InputPrice < 0 || form.CachedPrice < 0 || form.OutputPrice < 0)
        {
            priceError = "A price is a number of dollars, zero or more.";
            return;
        }

        //The last word before it is saved, for a change to the address that came some other way than its field.
        KeepTheSavedKeyToItsTransport();

        if (isEditing && originalName != null && name != originalName)
            connections.Remove(originalName);

        form.Name = name;
        connections[name] = form;
        selectedKey = name;
        showForm = false;
        formError = null;
        priceError = null;

        await Store.SaveAsync(connections);

        ShowSelectedInForm();

        await NotifySelectedAsync();
    }

    ///<summary>Deletes a saved model; when it was the chosen one, the first left is chosen, or the form for a new one.</summary>
    private async Task DeleteAsync(string key)
    {
        if (string.IsNullOrEmpty(key) || !connections.Remove(key))
            return;

        if (selectedKey == key)
        {
            selectedKey = connections.Keys.FirstOrDefault();

            ShowSelectedInForm();
        }

        await Store.SaveAsync(connections);
        await NotifySelectedAsync();
    }
}
