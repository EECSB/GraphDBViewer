    private string AttachTitle => $"Attach files to the next question: pictures, PDFs, Excel and Word files, CSV, JSON, GraphML and other text, up to {AiAttachment.MostPerQuestion}. A picture pasted into the box, or files dropped on the conversation, go the same way";

