    ///<summary>
    ///Downloads a chat as text, to read back or paste in another day (<see cref="AiChat.Transcript"/>), named for when it was
    ///saved. Not while an answer is coming, which would leave it half written.
    ///</summary>
    private async Task ExportAsync(AiChat transcript, string subject)
    {
        if (transcript.Turns.Count == 0 || transcript.Generating)
            return;

        var now = DateTime.Now;
        var name = $"{AiChat.FileNameOf(Title)}-{now.ToString("yyyyMMdd-HHmm", System.Globalization.CultureInfo.InvariantCulture)}.txt";

        try
        {
            await JS.InvokeVoidAsync("exportInterop.downloadText", name, transcript.Transcript(subject, now), "text/plain");
        }
        catch (JSException ex)
        {
            //Said in the chat, where the export was asked for: a download that did not happen and nothing said is a press
            //on a button that did nothing (GDS Viewer's, 2026-11-03).
            transcript.Refuse($"The export could not be downloaded: {ex.Message}");
            StateHasChanged();
        }
    }

