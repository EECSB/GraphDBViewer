    private static string SentChipTitle(AiAttachment file)
    {
        var said = $"{file.Name}, {AiAttachment.Size(file.Data.Length)}";

        if (file.Excluded)
            return said + ". Left out of the conversation since: tick it in the files panel to send it again";

