    ///<summary>What the card says happened: the window owner's words, or a general one by the kind of call and how it ended.</summary>
    private string CardTitleOf(ChatTurn turn)
    {
        if (CardTitle != null)
            return CardTitle(turn);

        var tool = ToolLabelOf(turn.ToolName);

        if (turn.Decision == null)
            return $"The model wants to use: {tool}";
        else if (turn.Decision == false)
            return $"The model asked to use: {tool}";

        return $"The model used: {tool}";
    }

    ///<summary>
    ///What the window's owner draws for a call that went ahead, or null where it draws nothing of its own (<see cref="CardResult"/>).
    ///Asked from the moment the call goes ahead, so its arguments are not shown while it runs and then taken away.
    ///</summary>
    private RenderFragment OwnResultOf(ChatTurn turn)
    {
        if (CardResult == null || turn.Decision != true || turn.ResultIsError)
            return null;

        return CardResult(turn);
    }

    ///<summary>Whether a card shows what its call was asked with: not for a call with nothing to show, as a look at a picture has.</summary>
    private static bool ShowsArguments(ChatTurn turn)
    {
        if (!string.IsNullOrWhiteSpace(turn.Query))
            return true;

        var arguments = (turn.ArgumentsJson ?? "").Trim();

        return arguments.Length > 0 && arguments != "{}";
    }

    #region Sending

    private bool CanSend()
    {
        if (TypedSlash() != null && !chat.Generating)
            return true;

        return selected != null && !chat.Generating && !string.IsNullOrWhiteSpace(nlPrompt) && Blocked() == null;
    }

    private string SendTitle
    {
        get
        {
            if (chat.Generating)
                return "Stop the answer. A query it already ran has run";
            else if (selected == null)
                return "Add a model under AI settings first";

            if (Blocked() is string why)
                return why;

            return "Send. Enter does the same";
        }
    }

    ///<summary>
    ///Enter sends; Shift+Enter breaks the line. Only half of that is decided here: the newline itself is refused in JS,
    ///because a Blazor handler's preventDefault is fixed when the component renders rather than when the key is pressed.
    ///</summary>
    private async Task OnPromptKeyDownAsync(KeyboardEventArgs e)
    {
        if (await SlashKeyAsync(e))
            return;

        if (e.Key != "Enter" || e.ShiftKey || e.IsComposing)
            return;

        if (await RunTypedSlashAsync())
            return;

        await SendAsync();
    }

    ///<summary>
    ///Send, or Stop while an answer is coming. <strong>A double-click on Send does not stop what it sent</strong>: the first
    ///click sends and the button becomes Stop under the pointer, so a click the browser counts as the second of a pair is
    ///let go.
    ///</summary>
    private async Task SendOrStopAsync(MouseEventArgs e)
    {
        if (chat.Generating)
        {
            if (e.Detail < 2)
                chat.Cancel();

            return;
        }

        if (await RunTypedSlashAsync())
            return;

        await SendAsync();
    }

    private async Task SendAsync()
    {
        if (selected == null || string.IsNullOrWhiteSpace(nlPrompt) || chat.Generating || Blocked() != null)
            return;

        if (await ReadPdfsAsync() is string unread)
        {
            attachProblem = unread;

            return;
        }

        var text = nlPrompt;

        nlPrompt = "";
        slashProblem = "";
        attachProblem = "";

        //Emptied in the page too, so the box shrinks against what is in it now rather than against the
        //message that has just left it. Nothing fires an input event when C# clears a bound value.
        try
        {
            await JS.InvokeVoidAsync("floatingDialog.resetComposer", promptBox);
        }
        catch { }

        //Effort and fast mode are chosen per request, so they ride on a copy: set on the stored connection they would be
        //saved against the model for every feature that uses it.
        var provider = LlmProviderFactory.Create(LlmHttpClient.For(Services, Http), Asked());
        var shown = chatShown;

        //As set under AI settings when this is sent, so a change there holds from the next message on.
        chat.MaxToolRounds = await Store.Rounds.GetAsync();

        var outcome = await chat.SendAsync(text, provider, SystemPrompt(), ToolsNow());

        if (shown == chatShown)
            await KeepChatAsync();

        //A question that failed with files gives them back to the box (AiChat.GaveFilesBack), and its words with them when
        //the box is still empty, rather than leaving them to be typed again.
        if (outcome == ChatOutcome.Failed && chat.GaveFilesBack && string.IsNullOrWhiteSpace(nlPrompt))
        {
            nlPrompt = text;
            composerSized = false;
        }
    }

    private string SystemPrompt()
    {
        if (Instructions == null)
            return "You are an assistant in a chat window, talking with the person who opened it.";

        return Instructions(chat.Mode, chat.ToolsOff);
    }

    ///<summary>The tools the next question goes with, as the window's owner gives them; null for none.</summary>
    private ILlmToolRunner ToolsNow()
    {
        if (Tools == null)
            return null;

        return Tools();
    }

    ///<summary>Carries a paused run on: a message of its own, with the calls before the pause going with it in words.</summary>
    private async Task ContinueAsync()
    {
        var typed = nlPrompt;

        nlPrompt = AiChat.ContinueText;

        await SendAsync();

        //What was typed goes back, also where Continue could not go, or went and gave its files back with its own words.
        if (string.IsNullOrEmpty(nlPrompt) || nlPrompt == AiChat.ContinueText)
            nlPrompt = typed;
    }

    ///<summary>An example under the empty conversation's words, put in the box with the keyboard there, to send or change first.</summary>
    ///<summary>
    ///Puts <paramref name="text"/> in the box to send or change first, as an example's press does, unless something is being
    ///written there already: for a button of the owner's elsewhere on the page that starts a conversation of a kind.
    ///</summary>
    public async Task PutInBoxAsync(string text)
    {
        if (!string.IsNullOrWhiteSpace(nlPrompt))
            await FocusPromptAsync();
        else
            await UseExampleAsync(text);
    }

    private async Task UseExampleAsync(string example)
    {
        nlPrompt = example;
        composerSized = false;

        StateHasChanged();

        await FocusPromptAsync();
    }

    ///<summary>A press in the box's frame but on none of its controls, which puts the caret in the box.</summary>
    private async Task FocusPromptAsync()
    {
        try
        {
            await promptBox.FocusAsync();
        }
        catch { }
    }

