    #region The meter

    ///<summary>What the next request costs, what has been spent and the rates: the same in the card the (i) shows while pointed at and on the line under the box.</summary>
    private RenderFragment MeterLines()
    {
        return @<span class="gdbv-ai-meter-lines">
            <span data-testid="ai-estimate" title="@EstimateTitle()">@EstimateLine()</span>

            @if (chat.Used.Reported)
            {
                <span class="gdbv-ai-spent" data-testid="ai-spent" title="@SpentTitle()">@SpentLine()</span>
            }

            @if (selected != null && AiPricing.PricingPage(selected.ProviderType) is string published)
            {
                <a class="gdbv-ai-rates" href="@published" target="_blank" rel="noopener noreferrer" title="@RatesTitle()">rates</a>
            }
        </span>;
    }

    private string MeterLabel
    {
        get
        {
            if (meterOn)
                return $"{EstimateLine()}. Press to take the costs off the line under the box";

            return $"{EstimateLine()}. Press to keep the costs on a line under the box";
        }
    }

    ///<summary>The next request as it would go now: the instructions, the tools, the conversation with its ticked files, and the box with its files.</summary>
    private long NextRequestTokens()
    {
        long toolTokens = 0;

        if (ToolsNow() is ILlmToolRunner tools)
            toolTokens = AiEstimate.ToolTokens(new SwitchableToolRunner(tools, chat.ToolsOff).Tools);

        var conversation = chat.BuildConversation();

        conversation.Add(LlmMessage.FromUser(nlPrompt, chat.Pending.ToArray()));

        return AiEstimate.Request(SystemPrompt(), toolTokens, conversation, selected.ProviderType);
    }

    private string EstimateLine()
    {
        if (selected == null)
            return "";

        var tokens = NextRequestTokens();
        var said = $"Next request: about {AiPricing.About(tokens)} tokens";

        if (AiPricing.For(Asked(), DateTime.UtcNow) is LlmPrice price)
            said += $", {AiPricing.Money(price.CostOfInput(tokens))} to send";

        return said;
    }

    private string EstimateTitle()
    {
        var said = new List<string>
        {
            "What sending now puts in front of the model: its instructions, the tools, this conversation with its ticked files, and the box with its files.",
            "Every round of tool calls sends it again, and an answer is billed on top at the output rate; on Anthropic most of a round is read back from the cache, at a tenth of the rate or less.",
            "Counted from characters, at about 3.5 a token; what was really billed shows under each answer."
        };

        if (selected != null && AiPricing.For(selected, DateTime.UtcNow) == null)
            said.Add("This model has no rate, so no cost is shown: give it one under AI settings.");

        return string.Join(" ", said);
    }

    private string SpentLine()
    {
        if (chat.Cost is decimal dollars)
            return "Spent: " + AiPricing.Money(dollars);

        var used = chat.Used;

        return $"Spent: {AiPricing.Count(used.InputTokens)} tokens in, {AiPricing.Count(used.OutputTokens)} out";
    }

    private string SpentTitle()
    {
        var said = new StringBuilder("What the providers reported billing since this page opened - a new chat does not take it back:");

        foreach (var (model, spent) in chat.Spend)
        {
            said.AppendLine();
            said.Append($"{model}: {AiPricing.Count(spent.Usage.InputTokens)} tokens in");

            if (spent.Usage.CachedInputTokens > 0)
                said.Append($" ({AiPricing.Count(spent.Usage.CachedInputTokens)} read from the cache)");

            said.Append($", {AiPricing.Count(spent.Usage.OutputTokens)} out, in {spent.Usage.Requests} requests");

            if (spent.Cost is decimal dollars)
                said.Append($" - {AiPricing.Money(dollars)}");
            else
                said.Append(" - no rate for this model");
        }

        return said.ToString();
    }

    private string RatesTitle()
    {
        var where = "Where the provider publishes its rates";

        if (selected != null && AiPricing.For(Asked(), DateTime.UtcNow) is LlmPrice price)
            return $"{where}. The figures here use {price.Source}. A model's own rates can be set under AI settings";

        return $"{where}. This model has no rate here: give it one under AI settings";
    }

    #endregion

    #region Slash commands

    ///<summary>
    ///<strong>A slash at the start of the box lists what the window can do</strong> (2026-11-01, GDS Viewer's, where it was
    ///asked for on 2026-10-31, as Claude has them): its own actions and questions it is often asked, written out. Typing
    ///narrows the list; the arrows move through it, Enter or a press runs the one marked, Tab writes its name out to add
    ///words after it, and Escape puts the list away. A command that cannot run now stays listed, dimmed, saying why. A
    ///question command sends its question at once, with any words written after its name added to it. Nothing reaches the
    ///model by its slash: a name that is no command is sent as it was written.
    ///</summary>
    private sealed record SlashCommand(string Name, string Says, string Why, string Question = null);

    ///<summary>The marked row of the list, which the arrows move.</summary>
    private int slashIndex;

    ///<summary>The box's words when Escape put the list away: it stays away until they change.</summary>
    private string slashDismissed;

    ///<summary>Why the command last asked for could not run, under the box until the next one.</summary>
    private string slashProblem = "";

    ///<summary>Every command, in the order listed, each with why it cannot run now or null.</summary>
    private List<SlashCommand> SlashCommands()
    {
        string busy = null;

        if (chat.Generating)
            busy = "Once the answer is in";

        var asking = busy;

        if (asking == null && selected == null)
            asking = "Add a model under AI settings first";

        var newWhy = busy;

        if (newWhy == null && chat.Turns.Count == 0)
            newWhy = "This chat is new already";

        var exportWhy = busy;

        if (exportWhy == null && chat.Turns.Count == 0)
            exportWhy = "Nothing has been said in this chat yet";

        string settingsWhy = null;

        if (!OnOpenSettings.HasDelegate)
            settingsWhy = "AI settings are not on this page";

        var commands = new List<SlashCommand>
        {
            new SlashCommand("new", "Start a new chat. This one stays in the chats list", newWhy),
            new SlashCommand("compact", "Replace the conversation so far with a briefing the assistant carries on from", CompactBlocked()),
            new SlashCommand("export", "Save this chat as text", exportWhy),
            new SlashCommand("tools", "Choose the tools the assistant may use in this chat", null)
        };

        if (AllowCamera)
        {
            commands.Add(new SlashCommand("camera", "Take a picture with your camera, for the next question", null));
            commands.Add(new SlashCommand("screenshot", "Attach a screenshot of a screen, a window or a tab", null));
        }

        commands.Add(new SlashCommand("settings", "Open AI settings: the models, their keys, and speech to text", settingsWhy));

        //The window owner's own: questions, which wait for a model, and for whatever else the owner says they need.
        foreach (var own in Commands)
        {
            var why = asking;

            if (why == null && own.WhyNot != null)
                why = own.WhyNot();

            commands.Add(new SlashCommand(own.Name, own.Says, why, own.Question));
        }

        return commands;
    }

    ///<summary>The name being typed after the box's leading slash, or null when the box holds anything else.</summary>
    private string SlashTyped()
    {
        if (string.IsNullOrEmpty(nlPrompt) || nlPrompt[0] != '/')
            return null;

        var name = nlPrompt.Substring(1);

        if (name.Any(character => !char.IsAsciiLetterLower(character)))
            return null;

        return name;
    }

    ///<summary>The commands whose names start with what is typed after the slash.</summary>
    private List<SlashCommand> SlashMatches()
    {
        var typed = SlashTyped();

        if (typed == null)
            return new List<SlashCommand>();

        return SlashCommands().Where(command => command.Name.StartsWith(typed, StringComparison.Ordinal)).ToList();
    }

    private bool SlashShown()
    {
        if (nlPrompt == slashDismissed)
            return false;

        return SlashMatches().Count > 0;
    }

    ///<summary>The command and its words when the box holds one written out, "/count products only", or null.</summary>
    private (SlashCommand Command, string Words)? TypedSlash()
    {
        var text = (nlPrompt ?? "").Trim();

        if (text.Length < 2 || text[0] != '/')
            return null;

        var end = 1;

        while (end < text.Length && char.IsAsciiLetterLower(text[end]))
            end++;

        if (end < text.Length && !char.IsWhiteSpace(text[end]))
            return null;

        var name = text.Substring(1, end - 1);
        var command = SlashCommands().FirstOrDefault(each => each.Name == name);

        if (command == null)
            return null;

        return (command, text.Substring(end).Trim());
    }

    ///<summary>The list's keys while it is up. Answers whether the key was the list's.</summary>
    private async Task<bool> SlashKeyAsync(KeyboardEventArgs e)
    {
        if (!SlashShown() || e.IsComposing)
            return false;

        var offered = SlashMatches();

        if (slashIndex >= offered.Count)
            slashIndex = 0;

        if (e.Key == "ArrowDown")
        {
            slashIndex = (slashIndex + 1) % offered.Count;

            return true;
        }
        else if (e.Key == "ArrowUp")
        {
            slashIndex = (slashIndex + offered.Count - 1) % offered.Count;

            return true;
        }
        else if (e.Key == "Escape")
        {
            slashDismissed = nlPrompt;

            return true;
        }
        else if (e.Key == "Tab")
        {
            nlPrompt = $"/{offered[slashIndex].Name} ";

            return true;
        }
        else if (e.Key == "Enter" && !e.ShiftKey)
        {
            await RunSlashAsync(offered[slashIndex], string.Empty);

            return true;
        }

        return false;
    }

    ///<summary>Runs the command written out in the box, if it holds one. Answers whether it did, or said why it could not.</summary>
    private async Task<bool> RunTypedSlashAsync()
    {
        var typed = TypedSlash();

        if (typed == null)
            return false;

        await RunSlashAsync(typed.Value.Command, typed.Value.Words);

        return true;
    }

    private async Task RunSlashAsync(SlashCommand command, string words)
    {
        slashProblem = "";
        slashIndex = 0;

        if (command.Why != null)
        {
            slashProblem = $"/{command.Name}: {command.Why}.";

            return;
        }

        if (command.Question != null)
        {
            var question = command.Question;

            if (words.Length > 0)
                question = $"{question} {words}";

            nlPrompt = question;

            await SendAsync();

            return;
        }

        nlPrompt = "";

        try
        {
            await JS.InvokeVoidAsync("floatingDialog.resetComposer", promptBox);
        }
        catch { }

        if (command.Name == "new")
            NewChat();
        else if (command.Name == "compact")
            await CompactAsync();
        else if (command.Name == "export")
            await ExportAsync(chat, Subject);
        else if (command.Name == "tools")
            TogglePicker();
        else if (command.Name == "camera" && !cameraOpen)
            await ToggleCameraAsync();
        else if (command.Name == "screenshot")
            await ScreenshotAsync();
        else if (command.Name == "settings")
            await OnOpenSettings.InvokeAsync();
    }

    #endregion

    #region The camera and a screenshot

    ///<summary>Whether the camera's card is open over the box.</summary>
    private bool cameraOpen;

    ///<summary>Whether the open card's camera has been asked for, once it is on the page (see OnAfterRenderAsync).</summary>
    private bool cameraStarted;

    private ElementReference cameraVideo;

    ///<summary>Why the camera shows nothing, in its card where the shutter would be.</summary>
    private string cameraProblem = "";

    private async Task ToggleCameraAsync()
    {
        if (cameraOpen)
        {
            await CloseCameraAsync();

            return;
        }

        cameraOpen = true;
        cameraStarted = false;
        cameraProblem = "";
    }

    ///<summary>Puts the card away and stops every track, or the camera's light stays on.</summary>
    private async Task CloseCameraAsync()
    {
        cameraOpen = false;

        try
        {
            await JS.InvokeVoidAsync("aiCamera.close");
        }
        catch { }
    }

    private async Task CameraKeyAsync(KeyboardEventArgs e)
    {
        if (e.Key == "Escape")
            await CloseCameraAsync();
    }

    ///<summary>
    ///A screenshot, picked in the browser's own window and attached through the paperclip's input. A picker closed without a
    ///choice attaches nothing and says nothing: it is somebody changing their mind, not a failure.
    ///</summary>
    private async Task ScreenshotAsync()
    {
        attachProblem = "";

        var why = "The screenshot could not be taken.";

        try
        {
            why = await JS.InvokeAsync<string>("aiCamera.screenshot", AttachInputId);
        }
        catch { }

        if (!string.IsNullOrEmpty(why) && why != "canceled")
            attachProblem = why;
    }

    ///<summary>The frame on screen, attached through the paperclip's input, which is where its checks are, and the card closed.</summary>
    private async Task CaptureAsync()
    {
        var why = "The picture could not be taken.";

        try
        {
            why = await JS.InvokeAsync<string>("aiCamera.capture", cameraVideo, AttachInputId);
        }
        catch { }

        if (!string.IsNullOrEmpty(why))
        {
            cameraProblem = why;

            return;
        }

        await CloseCameraAsync();
    }

    ///<summary>The window was closed: what the microphone was hearing is let go unwritten, and the camera's card goes.</summary>
    private async Task PutDevicesAwayAsync()
    {
        listening = false;
        cameraOpen = false;

        try
        {
            await JS.InvokeVoidAsync("aiSpeech.cancel");
            await JS.InvokeVoidAsync("aiCamera.close");
        }
        catch { }

        StateHasChanged();
    }

    #endregion

    #region The microphone

    ///<summary>How the microphone turns speech into words, chosen in AI settings (<see cref="SpeechPreference"/>).</summary>
    private SpeechMode speechMode = SpeechMode.Browser;

    ///<summary>The way the listening going now was started, which a change of setting halfway through does not change.</summary>
    private SpeechMode listeningMode = SpeechMode.Browser;

    ///<summary>Whether this browser has a recognizer of its own, asked once the page is up.</summary>
    private bool browserSpeech;

    ///<summary>Whether the microphone is listening or recording.</summary>
    private bool listening;

    ///<summary>How many bars the level meter in the box has, newest on the right.</summary>
    private const int MicLevelBars = 16;

    ///<summary>The level meter, while the microphone listens (showLevel in SpeechInterop.js).</summary>
    private ElementReference micLevel;

    ///<summary>Whether the meter of the listening going now has been started, once its bars are on the page.</summary>
    private bool micLevelStarted;

    ///<summary>Whether a recording is with the provider, being written out.</summary>
    private bool transcribing;

    ///<summary>Why the microphone has nothing to show, under the box until it is pressed again.</summary>
    private string speechProblem = "";

    private CancellationTokenSource transcribeStop;

    private async Task SpeechChangedAsync()
    {
        speechMode = await Store.Speech.GetAsync();

        await InvokeAsync(StateHasChanged);
    }

    ///<summary>Whether a press on the microphone can do anything here, which dims it when not; dimmed, it still says why when pointed at.</summary>
    private bool MicUsable()
    {
        return speechMode == SpeechMode.Provider || browserSpeech;
    }

    private string MicLabel()
    {
        if (transcribing)
            return "Writing out what you said";

        if (listening)
            return "Stop listening";

        return "Speak your question";
    }

    ///<summary>What the microphone says when pointed at: what a press does in the way it is set to, and the other way and what it is better at.</summary>
    private string MicTitle()
    {
        if (transcribing)
            return "Writing out what you said…";

        if (listening && listeningMode == SpeechMode.Provider)
            return "Recording: press to stop, and the AI provider writes it out";

        if (listening)
            return "Listening: press to stop";

        if (speechMode == SpeechMode.Provider)
            return "Speak your question: press, talk, and press again. An OpenAI or Gemini model writes it out, told the words this window expects, and the provider bills it. For live words as you talk, switch Speech to text to Browser in AI settings";

        if (!browserSpeech)
            return "This browser has no speech recognition of its own. Switch Speech to text to AI provider in AI settings, and the microphone records instead";

        return "Speak your question: your browser writes it into the box as you talk (Chrome and Edge send the audio to Google or Microsoft). For better accuracy with labels and query words, switch Speech to text to AI provider in AI settings";
    }

    private async Task MicAsync()
    {
        if (transcribing)
            return;

        speechProblem = "";

        if (listening)
        {
            await StopSpeechAsync();

            return;
        }

        listeningMode = speechMode;

        if (speechMode == SpeechMode.Browser)
        {
            if (!browserSpeech)
            {
                speechProblem = "This browser has no speech recognition of its own: Chrome and Edge have. Or switch Speech to text to AI provider in AI settings, and the microphone records instead.";

                return;
            }

            try
            {
                listening = await JS.InvokeAsync<bool>("aiSpeech.startListening", promptBox, handle);
            }
            catch { }

            if (!listening)
                speechProblem = "The browser's speech recognition could not start. Press the microphone again.";

            return;
        }

        var why = "The microphone could not be started.";

        try
        {
            why = await JS.InvokeAsync<string>("aiSpeech.startRecording", handle);
        }
        catch { }

        if (!string.IsNullOrEmpty(why))
        {
            speechProblem = why;

            return;
        }

        listening = true;
    }

    private async Task StopSpeechAsync()
    {
        if (listeningMode == SpeechMode.Browser)
        {
            try
            {
                await JS.InvokeVoidAsync("aiSpeech.stopListening");
            }
            catch { }

            return;
        }

        listening = false;
        transcribing = true;

        StateHasChanged();

        var recorded = "";

        try
        {
            recorded = await JS.InvokeAsync<string>("aiSpeech.stopRecording");
        }
        catch (Exception ex)
        {
            speechProblem = $"The recording could not be read: {ex.Message}";
        }

        try
        {
            await TranscribeAsync(recorded);
        }
        finally
        {
            transcribing = false;
        }
    }

    ///<summary>
    ///The browser's recognizer ended, or the recording reached its limit. The recognizer's words are in the box already, put
    ///there as if typed; a recording at its limit is written out as if the microphone had been pressed.
    ///</summary>
    [JSInvokable]
    public async Task OnSpeechEnded(string problem)
    {
        if (problem == "limit")
        {
            if (listening && listeningMode == SpeechMode.Provider)
                await StopSpeechAsync();

            StateHasChanged();

            return;
        }

        listening = false;

        if (!string.IsNullOrEmpty(problem))
            speechProblem = problem;

        composerSized = false;

        StateHasChanged();
    }

    ///<summary>The words the provider is told to expect: the window owner's terms, or none.</summary>
    private IEnumerable<string> VocabularyNow()
    {
        if (Vocabulary == null)
            return Array.Empty<string>();

        return Vocabulary() ?? Array.Empty<string>();
    }

    ///<summary>Sends a recording to be written out, and puts what came back after what the box holds.</summary>
    private async Task TranscribeAsync(string recorded)
    {
        if (string.IsNullOrEmpty(recorded))
        {
            if (speechProblem.Length == 0)
                speechProblem = "Nothing was recorded.";

            return;
        }

        var saved = await Store.LoadAsync();
        var model = SpeechTranscriber.Pick(selected, saved.Values);

        if (model == null)
        {
            speechProblem = "Speech written out by the AI provider takes an OpenAI or Gemini model: add one in AI settings, or switch Speech to text to Browser there. Claude models take no audio.";

            return;
        }

        var stop = new CancellationTokenSource();

        transcribeStop = stop;

        try
        {
            var wav = Convert.FromBase64String(recorded);
            var (text, problem) = await SpeechTranscriber.TranscribeAsync(LlmHttpClient.For(Services, Http), model, wav, SpeechTranscriber.Vocabulary(VocabularyNow()), stop.Token);

            if (problem != null)
            {
                speechProblem = problem;

                return;
            }

            if (string.IsNullOrWhiteSpace(text))
            {
                speechProblem = "Nothing was heard in the recording.";

                return;
            }

            if (string.IsNullOrWhiteSpace(nlPrompt))
                nlPrompt = text.Trim();
            else
                nlPrompt = nlPrompt.TrimEnd() + " " + text.Trim();

            composerSized = false;
        }
        catch (OperationCanceledException)
        {
        }
        finally
        {
            if (transcribeStop == stop)
                transcribeStop = null;

            stop.Dispose();
        }
    }

    #endregion
}
