    ///<summary>What the history costs every question now, and what compacting it would cost once, on the model picked.</summary>
    private string CompactSuggestion()
    {
        var history = chat.HistoryTokens(selected.ProviderType);
        var price = AiPricing.For(Asked(), DateTime.UtcNow);
        var said = new StringBuilder($"This conversation sends about {AiPricing.About(history)} tokens of history with every question");

        if (price != null)
            said.Append($", {AiPricing.Money(price.CostOfInput(history))} each time");

        said.Append($". Compacting puts a briefing of about {AiPricing.About(AiChat.BriefingTokens)} tokens in its place");

