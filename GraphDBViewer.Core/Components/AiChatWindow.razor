    ///<summary>
    ///Compact, from the picker, the suggestion or /compact: the conversation so far replaced by a briefing
    ///(<see cref="AiChat.CompactAsync"/>), on the model picked at the least effort it takes, since a briefing carries facts
    ///across rather than reasoning about them. Not in fast mode, which would pay twice for that.
    ///</summary>
    private async Task CompactAsync()
    {
        if (CompactBlocked() != null)
            return;

        pickerOpen = false;

        var least = "";

        if (LlmConnection.SupportsEffort(selected))
            least = "low";

        var provider = LlmProviderFactory.Create(LlmHttpClient.For(Services, Http), new LlmConnection(selected) { Effort = least });
        var shown = chatShown;

        if (await chat.CompactAsync(provider) == ChatOutcome.Answered)
            showEarlier = false;

        if (shown == chatShown)
            await KeepChatAsync();
    }

