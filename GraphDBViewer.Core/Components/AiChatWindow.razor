    #region The tool picker

    ///<summary>
    ///The tools on offer now, as the picker lists them: in two groups by what they do, reading first and changing after,
    ///each tool by its label. A group with none is left out.
    ///</summary>
    private List<(string Group, List<(string Name, string Says)> Tools)> ToolGroups()
    {
        var reading = new List<(string Name, string Says)>();
        var changing = new List<(string Name, string Says)>();

        var tools = ToolsNow();

        //As the model is offered them: every question here goes through the approval gate, which offers the tools that
        //change things too (ApprovingToolRunner), so the picker lists them before the first question as well.
        if (tools is IWriteCapableToolRunner writable)
            writable.AllowWrites = true;

        if (tools != null)
            foreach (var tool in tools.Tools)
                if (tool.Changes)
                    changing.Add((tool.Name, ToolLabelOf(tool)));
                else
                    reading.Add((tool.Name, ToolLabelOf(tool)));

        var groups = new List<(string Group, List<(string Name, string Says)> Tools)>();

        if (reading.Count > 0)
            groups.Add(("Reading", reading));

        if (changing.Count > 0)
            groups.Add(("Changing", changing));

        return groups;
    }

    ///<summary>What the picker calls a tool: the window owner's label, or its own description's first sentence.</summary>
    private string ToolLabelOf(LlmTool tool)
    {
        if (ToolLabel != null && ToolLabel(tool) is string label && label.Length > 0)
            return label;

        var described = (tool.Description ?? "").Trim();
        var end = described.IndexOf(". ", StringComparison.Ordinal);

        if (end > 0)
            described = described.Substring(0, end);

        if (described.Length == 0)
            return tool.Name;

        return described.TrimEnd('.');
    }

    ///<summary>A card's tool by its label, where the tool is still on offer, or by its name.</summary>
    private string ToolLabelOf(string name)
    {
        if (ToolsNow() is ILlmToolRunner tools && tools.Tools.FirstOrDefault(tool => tool.Name == name) is LlmTool offered)
            return ToolLabelOf(offered);

        return name;
    }

    ///<summary>A group's all or none.</summary>
    private void SetTools(List<(string Name, string Says)> tools, bool on)
    {
        foreach (var (name, _) in tools)
            if (on)
                chat.ToolsOff.Remove(name);
            else
                chat.ToolsOff.Add(name);
    }

