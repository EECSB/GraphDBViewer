    ///<summary>How many files the conversation holds: sent, ticked or not, and waiting for the next question.</summary>
    private int FileCount()
    {
        return chat.SentFiles().Count + chat.Pending.Count;
    }

    ///<summary>
    ///Files chosen with the paperclip, or pasted or dropped and handed to its input: each read and put in the box, or turned
    ///away with why. One at a time, so a picture too big costs the others nothing, and one far too big is turned away on
    ///its size before a byte of it is read: OpenReadStream throws past its own maximum, which would be a failure rather
    ///than a reason.
    ///</summary>
    private async Task FilesChosenAsync(InputFileChangeEventArgs e)
    {
        var problems = new List<string>();

        //GetMultipleFiles throws past its maximum, so every file is taken and the count refuses the extras.
        foreach (var chosen in e.GetMultipleFiles(e.FileCount))
        {
            if (AiAttachment.Refusal(chosen.Name, chosen.ContentType, chosen.Size) is string refused)
            {
                problems.Add(refused);

                continue;
            }

            byte[] data;

            try
            {
                await using var stream = chosen.OpenReadStream(AiAttachment.MostBytes(AiAttachment.KindOf(chosen.Name, chosen.ContentType)));
                using var memory = new MemoryStream();

                await stream.CopyToAsync(memory);
                data = memory.ToArray();
            }
            catch (Exception failed)
            {
                problems.Add($"{chosen.Name} could not be read: {failed.Message}");

                continue;
            }

            //The bytes' own checks, and the question's and the conversation's budgets.
            if (chat.Attach(new AiAttachment(chosen.Name, chosen.ContentType, data)) is string problem)
                problems.Add(problem);
        }

        attachProblem = string.Join(" ", problems);

        MarkPdfs();
    }

