    ///<summary>What the ticked files and the waiting ones add to every question, under the files panel's lists.</summary>
    private string FilesWeight()
    {
        if (selected == null)
            return "";

        long tokens = 0;
        var files = 0;

        foreach (var (_, file) in chat.SentFiles())
        {
            if (file.Excluded)
                continue;

            tokens += AiEstimate.Attachment(file, selected.ProviderType);
            files++;
        }

        foreach (var file in chat.Pending)
        {
            tokens += AiEstimate.Attachment(file, selected.ProviderType);
            files++;
        }

        if (files == 0)
            return "No file goes with the next question.";

        var said = $"These add about {AiPricing.About(tokens)} tokens to every question";

        if (AiPricing.For(Asked(), DateTime.UtcNow) is LlmPrice price)
            said += $", {AiPricing.Money(price.CostOfInput(tokens))} at this model's rates";

        return said + ".";
    }

