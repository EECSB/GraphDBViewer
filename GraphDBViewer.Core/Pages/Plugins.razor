@page "/plugins"
@layout MainLayout
@using System.Net.Http.Json
@using GraphDBViewerWeb.Code
@using Microsoft.Extensions.DependencyInjection
@inject ViewerHostOptions HostOptions
@inject IServiceProvider Services
@inject HttpClient Http
@inject IJSRuntime JS
@inject NavigationManager Nav

@*The Plugins page (plugin-system phases 1 and 3): what this instance runs — bundled and installed —
   and the administrator's controls over it: install by manifest URL, enable, disable, uninstall,
   retry a quarantined one. Every change is a rewrite of the instance list and takes effect on a full
   reload, because nothing unloads at runtime. Gated on the install permission like the Settings-menu
   entry that links here — a courtesy the server repeats on the write endpoints.

   The plugin services resolve through GetService rather than @inject on purpose: the web-only
   edition registers none of them, shows its not-found face below, and must not be forced to carry
   registrations for a platform it does not have.*@
@if (HostOptions.HasPlugins)
{
    <PageTitle>Plugins · @HostOptions.AppName</PageTitle>

    @*One centered column, and every card in it the same width. Each section used to set its own
       max-width — 40rem here, 46rem there, none at all on the Store — so they disagreed about where
       the right edge was, and the whole page hugged the left of a wide window.*@
    <div class="mx-auto" style="max-width: 48rem;">
        <h3>Plugins</h3>

        @if (Account == null)
        {
            @*Who is asking is still being answered — a beat of nothing beats a flash of the wrong face.*@
        }
        else if (!Account.Can(AccountInfo.PluginsInstall))
        {
            <p>Managing plugins needs a permission your account does not hold. An administrator can grant it through a role.</p>
        }
        else
        {
            @if (report.SafeMode)
            {
                <div class="alert alert-warning">
                    <strong>Safe mode.</strong> No installed plugins were loaded on this boot. Remove or disable the one
                    that was breaking things, then <a href="/plugins">leave safe mode</a>.
                </div>
            }

            @if (pendingReload)
            {
                <div class="alert alert-info d-flex align-items-center gap-3">
                    <span class="flex-grow-1">Changes are saved and take effect on a full reload — nothing unloads at runtime.</span>
                    <button type="button" class="btn btn-primary btn-sm" @onclick="Reload">Reload now</button>
                </div>
            }

            @if (!string.IsNullOrEmpty(error))
            {
                <div class="alert alert-danger">@error</div>
            }

            @if (!string.IsNullOrEmpty(notice))
            {
                <div class="alert alert-success">@notice</div>
            }

            <p class="text-body-secondary">What this instance runs, and where more comes from: the store below, a manifest URL, or a zip.</p>

            <div class="card gdbv-tint mb-3">
                <div class="list-group list-group-flush">
                    @foreach (var row in Rows())
                    {
                        @*Two lines, not one. Everything a row says about itself in a sentence — a retype
                           report, an update offer — used to sit in the right-hand column beside the buttons,
                           which is sized for buttons and does not shrink: one long report pushed the column
                           wide, squeezed the plugin's own name into two lines and spilled past the card. So
                           the top line is name and controls, and anything with prose in it gets the full
                           width underneath.*@
                        <div class="list-group-item bg-transparent">
                            <div class="d-flex align-items-center gap-3">
                                @if (row.Icon != null)
                                {
                                    <img src="@row.Icon" alt="" style="width: 1.8rem; height: 1.6rem; flex-shrink: 0;" />
                                }

                                <div class="flex-grow-1" style="min-width: 0;">
                                    <div><strong>@row.Name</strong> <span class="text-body-secondary ms-1">@row.Version</span></div>
                                    <div class="text-body-secondary text-break" style="font-size: .8rem;">@row.Id</div>

                                    @*A plugin that came out of a zip has no URL anywhere on this page to say
                                       where it came from, so it says the one thing there is to say.*@
                                    @if (row.Record != null && !string.IsNullOrWhiteSpace(row.Record.UploadedFile))
                                    {
                                        <div class="text-body-secondary text-break" style="font-size: .8rem;" data-testid="plugin-from-file">Installed from @row.Record.UploadedFile</div>
                                    }

                                    @if (row.Status != null)
                                    {
                                        <div class="@(row.Trouble ? "text-warning" : "text-body-secondary")" style="font-size: .8rem;">@row.Status</div>
                                    }
                                </div>

                                <div class="text-end" style="flex-shrink: 0;">
                                    @foreach (var link in row.PageLinks)
                                    {
                                        <div><a href="@link.Route">@link.Title →</a></div>
                                    }

                                    @if (row.Record != null)
                                    {
                                        <div><a href="@($"/plugins/settings/{row.Id}")">Settings →</a></div>

                                        <div class="d-flex gap-2 flex-wrap justify-content-end mt-1">
                                            @if (row.Quarantined)
                                            {
                                                <button type="button" class="btn btn-outline-secondary btn-sm" disabled="@busy" @onclick="() => RetryAsync(row.Record)">Retry</button>
                                            }

                                            <button type="button" class="btn btn-outline-secondary btn-sm" disabled="@busy" @onclick="() => ToggleEnabledAsync(row.Record)">
                                                @(row.Record.Enabled ? "Disable" : "Enable")
                                            </button>

                                            @*A plugin installed from a URL has no store entry to be told about a
                                               new version by, so it has to go and look. Store-installed ones
                                               already get Update from the Store tab, with a reviewed hash — and
                                               an uploaded one has nowhere to look at all, so it gets neither.*@
                                            @if (PluginIdentity.KindOf(PluginIdentity.MarkerOf(row.Record)) == PluginIdentity.OriginKind)
                                            {
                                                <button type="button" class="btn btn-outline-secondary btn-sm" disabled="@busy" @onclick="() => CheckUrlUpdateAsync(row.Record)" data-testid="plugin-check-updates">Check for updates</button>
                                            }

                                            <button type="button" class="btn btn-outline-danger btn-sm" disabled="@busy" @onclick="() => AskUninstallAsync(row.Record)">Uninstall</button>
                                        </div>
                                    }
                                    else if (row.Registered != null && row.Registered.Disabled)
                                    {
                                        <div class="d-flex gap-2 flex-wrap justify-content-end mt-1">
                                            <button type="button" class="btn btn-outline-secondary btn-sm" disabled="@busy" @onclick="() => RestoreBundledAsync(row.Registered)">Restore</button>

                                            @*The purge (ADR 0011, question 2), and it lives HERE rather than on the
                                               uninstall prompt: what an installed plugin holds is data, and what a
                                               removed one holds is leftovers. The endpoint refuses either way, so the
                                               button is only offered where it could work.*@
                                            <button type="button" class="btn btn-outline-danger btn-sm" disabled="@busy" @onclick="() => AskPurgeAsync(row.Registered)" data-testid="plugin-purge">Remove its data</button>
                                        </div>
                                    }
                                    else if (row.Registered != null && row.Registered.Removable)
                                    {
                                        <div class="text-body-secondary" style="font-size: .8rem;">Bundled</div>

                                        <div class="d-flex gap-2 flex-wrap justify-content-end mt-1">
                                            @if (RetypeSupported(row.Id))
                                            {
                                                @*The on-demand rewrite of the plugin's typed properties (ADR 0014,
                                                   question 1): a graph written before the seam was typed holds text
                                                   where numbers belong, and a range query under-matches until this runs.*@
                                                <button type="button" class="btn btn-outline-secondary btn-sm" disabled="@busy" @onclick="() => RetypeAsync(row.Registered)" data-testid="plugin-retype">Retype the graph</button>
                                            }
                                            <button type="button" class="btn btn-outline-danger btn-sm" disabled="@busy" @onclick="() => AskUninstallBundledAsync(row.Registered)">Uninstall</button>
                                        </div>
                                    }
                                    else
                                    {
                                        <div class="text-body-secondary" style="font-size: .8rem;">Bundled — part of the app</div>
                                    }
                                </div>
                            </div>

                            @*Everything a row says in a sentence, on its own full-width line under it. In the
                               column above, a report naming a time, a person and four counts had nowhere to
                               wrap and pushed the whole row past the card's edge.*@
                            @if (row.Record != null && urlUpdates.TryGetValue(row.Id, out var said) && !string.IsNullOrWhiteSpace(said))
                            {
                                <div class="text-body-secondary mt-2" style="font-size: .8rem;" data-testid="plugin-url-update">
                                    @said

                                    @if (urlOffers.ContainsKey(row.Id))
                                    {
                                        <button type="button" class="btn btn-outline-primary btn-sm py-0 ms-2" disabled="@busy" @onclick="() => TakeUrlUpdateAsync(row.Record)" data-testid="plugin-url-update-take">Update it</button>
                                    }
                                </div>
                            }

                            @if (row.Registered != null && retypes.TryGetValue(row.Id, out var retype) && retype != null && retype.Ran)
                            {
                                <div class="text-body-secondary mt-2" style="font-size: .8rem;" data-testid="plugin-retype-report">
                                    Retyped @Moment(retype.RanAt) by @retype.RanBy — @retype.Scanned scanned, @retype.Rewritten rewritten, @retype.Quarantined quarantined@(retype.Renamed > 0 ? $", {retype.Renamed} identities renamed to uid" : "").
                                </div>

                                @if (retype.Quarantined > 0)
                                {
                                    <div class="table-responsive">
                                        <table class="table table-sm mt-1 mb-0" style="font-size: .8rem;">
                                            <tbody>
                                                @foreach (var label in retype.Labels)
                                                {
                                                    @foreach (var quarantine in label.Quarantines)
                                                    {
                                                        <tr data-testid="plugin-retype-quarantine">
                                                            <td>@label.Label</td>
                                                            <td><code>@quarantine.Key</code></td>
                                                            <td>@quarantine.Property</td>
                                                            <td class="text-warning">@quarantine.Raw</td>
                                                        </tr>
                                                    }
                                                }
                                            </tbody>
                                        </table>
                                    </div>
                                }
                            }
                        </div>
                    }
                </div>
            </div>

            @if (uninstallTarget != null || uninstallBundled != null)
            {
                @*The uninstall prompt (ADR 0011): keeping is the default and the primary button, the
                   destructive option names what would go with counts, and configuration (settings and
                   grants — trivially recreated) is separable from graph data (the user's work).*@
                <div class="card gdbv-tint p-3 mb-3" style="border-color: var(--bs-warning);">
                    <strong>Uninstall @UninstallName()?</strong>

                    @if (uninstallNote != null)
                    {
                        <p class="mb-0 mt-2"><em>@uninstallNote</em></p>
                    }

                    <p class="mb-2 mt-2">Uninstalling removes its code and its pages, and keeps what it stored unless you say otherwise. What it stored here:</p>

                    <ul class="mb-2">
                        @if (uninstallLeftovers == null)
                        {
                            <li>What it stored could not be counted just now — you can still uninstall and keep everything.</li>
                        }
                        else
                        {
                            <li>
                                Configuration:
                                @if (uninstallLeftovers.Configuration)
                                {
                                    <text>1 stored value (@uninstallLeftovers.ConfigurationBytes characters)</text>
                                }
                                else
                                {
                                    <text>nothing stored</text>
                                }
                            </li>
                            <li>
                                Permission grants:
                                @if (uninstallLeftovers.PermissionGrants > 0)
                                {
                                    <text>@uninstallLeftovers.PermissionGrants on roles here</text>
                                }
                                else
                                {
                                    <text>none</text>
                                }
                            </li>
                            @if (uninstallLeftovers.InstanceGraphConfigured)
                            {
                                <li>Graph data: @uninstallLeftovers.GraphVertices vertices and @uninstallLeftovers.GraphEdges edges under this plugin's labels — kept. Removing it is offered after the uninstall, on the row this plugin leaves behind, and only where a backup vouches.</li>

                                @*What a purge will ask, shown where it will be asked (backups spec, criterion 6).*@
                                @if (!string.IsNullOrEmpty(uninstallLeftovers.BackupRefusal))
                                {
                                    <li data-testid="plugin-backup-refusal">@uninstallLeftovers.BackupRefusal <a href="/backups">Backups →</a></li>
                                }
                                else if (uninstallLeftovers.BackupTakenAt != null)
                                {
                                    <li data-testid="plugin-backup-vouches">A backup from @uninstallLeftovers.BackupTakenAt.Value.ToLocalTime().ToString("f") would vouch for removing this if it were offered.</li>
                                }
                            }
                            else
                            {
                                <li>Graph data: no instance graph is designated, so there is nothing to look in.</li>
                            }
                            @*A plugin that came out of a zip has its code here and nowhere else, which
                               makes it the one irreversible thing on a keep-everything uninstall. It
                               belongs in the prompt rather than in the notice afterwards, because this
                               is where the administrator is deciding.*@
                            @if (uninstallTarget != null && PluginUploads.IsUploaded(uninstallTarget))
                            {
                                <li data-testid="plugin-uploaded-code">
                                    Its code: uploaded here as <strong>@uninstallTarget.UploadedFile</strong> and kept by this
                                    instance, because there was no URL to fetch it from. <strong>It is deleted</strong> — and a
                                    backup does not carry it either, so installing it again means having the zip.
                                </li>
                            }

                            @*ADR 0011 §3: a plugin that asked for a container is responsible for it, so the
                               containers stop with the plugin — named here, because a stop that nobody
                               announced is an outage somebody has to diagnose.*@
                            @if (uninstallLeftovers.ContainersProblem != null)
                            {
                                <li data-testid="plugin-containers">Containers: @uninstallLeftovers.ContainersProblem</li>
                            }
                            else if (uninstallLeftovers.Containers.Count > 0)
                            {
                                <li data-testid="plugin-containers">
                                    Containers it started: @string.Join(", ", uninstallLeftovers.Containers) — they stop with it.
                                    Their volumes and the data on them stay, and restoring the plugin starts them again.

                                    @*MQTT criterion 11 asks for this in as many words: a stopped broker is not a
                                       plugin being disabled, it is a factory line with nowhere to publish. Named
                                       from the container rather than from the plugin id, so it says so whatever
                                       plugin is being removed.*@
                                    @if (uninstallLeftovers.Containers.Any(one => one.Contains("mqtt", StringComparison.OrdinalIgnoreCase)))
                                    {
                                        <strong data-testid="plugin-broker-warning"> The line loses its broker until then: devices publishing to it will have nowhere to publish.</strong>
                                    }
                                </li>
                            }
                            else
                            {
                                <li data-testid="plugin-containers">Containers: none.</li>
                            }
                        }
                    </ul>

                    <div class="d-flex gap-2 flex-wrap">
                        <button type="button" class="btn btn-primary" disabled="@busy" @onclick="() => UninstallAsync(deleteConfiguration: false)">Uninstall, keep everything</button>

                        @if (uninstallLeftovers != null && (uninstallLeftovers.Configuration || uninstallLeftovers.PermissionGrants > 0))
                        {
                            <button type="button" class="btn btn-outline-danger" disabled="@busy" @onclick="() => UninstallAsync(deleteConfiguration: true)">Uninstall and delete its configuration</button>
                        }

                        <button type="button" class="btn btn-outline-secondary ms-auto" disabled="@busy" @onclick="CancelUninstall">Cancel</button>
                    </div>
                </div>
            }

            @if (pendingInstall != null)
            {
                @*Trust on first use (ADR 0012): this id has leftovers from an install this copy cannot be
                   shown to be — adopt them deliberately, install clean, or walk away. Never inherit by
                   default.*@
                <div class="card gdbv-tint p-3 mb-3" style="border-color: var(--bs-warning);">
                    <strong>This id has been here before.</strong>

                    @*The sentence is PluginIdentity's, not this page's: there are three kinds of marker now
                       — an origin, a repository, an uploaded file's own bytes — and a page writing its own
                       version of it named the wrong one for two of the three.*@
                    <p class="mb-2 mt-2" data-testid="plugin-identity-says">
                        <code>@pendingInstall.Manifest.Id</code> — @PluginIdentity.Says(pendingIdentity?.Source, PluginIdentity.MarkerOf(pendingInstall))
                    </p>

                    <p class="mb-2 mt-2">
                        What was left behind —
                        @if (pendingLeftovers != null && pendingLeftovers.Configuration)
                        {
                            <text>a stored configuration (@pendingLeftovers.ConfigurationBytes characters)</text>
                        }
                        else
                        {
                            <text>no stored configuration</text>
                        }
                        and
                        @if (pendingLeftovers != null && pendingLeftovers.PermissionGrants > 0)
                        {
                            <text>@pendingLeftovers.PermissionGrants permission grants</text>
                        }
                        else
                        {
                            <text>no permission grants</text>
                        }
                        — would apply to it.
                    </p>

                    <div class="d-flex gap-2 flex-wrap">
                        <button type="button" class="btn btn-outline-secondary" disabled="@busy" @onclick="() => CommitPendingAsync(installClean: false)">Adopt what was left</button>
                        <button type="button" class="btn btn-outline-danger" disabled="@busy" @onclick="() => CommitPendingAsync(installClean: true)">Delete the leftovers and install clean</button>
                        <button type="button" class="btn btn-primary ms-auto" disabled="@busy" @onclick="CancelPending">Cancel</button>
                    </div>
                </div>
            }

            @if (purgeTarget != null)
            {
                @*The purge prompt. This is the only irreversible thing on the page that a backup cannot be
                   taken after, so keeping is the primary button, the destructive one is only rendered when
                   a backup vouches, and what will be LEFT is named as plainly as what will go.*@
                <div class="card gdbv-tint p-3 mb-3" style="border-color: var(--bs-danger);" data-testid="plugin-purge-prompt">
                    <strong>Remove @purgeTarget.Name's data from the instance graph?</strong>

                    @if (purgeLeftovers == null)
                    {
                        <p class="mb-2 mt-2">What it left could not be counted just now, so this is not offered.</p>
                    }
                    else
                    {
                        <ul class="mb-2 mt-2">
                            <li><strong>@purgeLeftovers.GraphVertices vertices and @purgeLeftovers.GraphEdges edges</strong> under this plugin's labels. Removing a vertex takes its edges with it.</li>

                            @if (purgeLeftovers.SharedLabels.Count > 0)
                            {
                                <li data-testid="plugin-purge-shared">
                                    <strong>Kept: @string.Join(", ", purgeLeftovers.SharedLabels).</strong> Another installed
                                    plugin owns those labels too, and nothing in the graph records which one wrote a given
                                    vertex — so removing them would take that plugin's work with them. Leaving them is
                                    recoverable; the other way is not.
                                </li>
                            }

                            <li><strong>This cannot be undone</strong> except by restoring the backup below.</li>
                        </ul>

                        @if (!string.IsNullOrEmpty(purgeLeftovers.BackupRefusal))
                        {
                            <p class="mb-2" data-testid="plugin-purge-refusal">@purgeLeftovers.BackupRefusal <a href="/backups">Backups →</a></p>
                        }
                        else if (purgeLeftovers.BackupTakenAt != null)
                        {
                            <p class="mb-2" data-testid="plugin-purge-vouches">The backup from @purgeLeftovers.BackupTakenAt.Value.ToLocalTime().ToString("f") vouches for this.</p>
                        }
                    }

                    <div class="d-flex gap-2 flex-wrap">
                        <button type="button" class="btn btn-secondary" disabled="@busy" @onclick="() => purgeTarget = null" data-testid="plugin-purge-keep">Keep it</button>

                        @if (purgeLeftovers != null && string.IsNullOrEmpty(purgeLeftovers.BackupRefusal))
                        {
                            <button type="button" class="btn btn-danger" disabled="@busy" @onclick="PurgeAsync" data-testid="plugin-purge-confirm">Remove the data</button>
                        }
                    </div>
                </div>
            }

            @*Take-downs, learned by opening the Store tab and never by a timer (open question 4). A notice
               with the uninstall in it — the instance never acts on the registry's behalf.*@
            @foreach (var (removal, record) in takedowns)
            {
                <div class="alert alert-warning" data-testid="plugin-takedown">
                    <strong>"@(record.Manifest?.Name ?? removal.Id)" was taken down from the registry@(string.IsNullOrWhiteSpace(removal.Date) ? "" : " on " + removal.Date).</strong>
                    <div class="mt-1" style="font-size: .85rem;">@removal.Reason</div>
                    <div class="mt-1" style="font-size: .85rem;">
                        Nothing has been changed here. It is still installed and still running; this is the registry
                        saying it would no longer list it.
                    </div>
                    <button type="button" class="btn btn-outline-danger btn-sm mt-2" disabled="@busy" @onclick="() => AskUninstallAsync(record)" data-testid="plugin-takedown-uninstall">Uninstall it</button>
                </div>
            }

            <div class="card gdbv-tint p-3 mb-3" data-testid="plugin-store">
                <h5 class="mb-2">Store</h5>
                <PluginStorePanel Installed="records" Busy="busy" OnInstall="StoreInstallAsync" OnUpdate="StoreUpdateAsync" OnRead="StoreRead" />
            </div>

            <div class="card gdbv-tint p-3">
                <h5 class="mb-2">Install a plugin</h5>

                <label for="manifest-url" class="form-label mb-1" style="font-size: .85rem;">From a manifest URL</label>
                <div class="d-flex gap-2">
                    <input id="manifest-url" class="form-control" placeholder="https://example.com/plugin/manifest.json" @bind="installUrl" @bind:event="oninput" />
                    <button type="button" class="btn btn-primary" style="flex-shrink: 0;" disabled="@(busy || string.IsNullOrWhiteSpace(installUrl))" @onclick="InstallAsync">
                        @(busy ? "Checking…" : "Install")
                    </button>
                </div>

                @*Install by file (plugin-system criterion 21). The zip is opened HERE, in the browser: the
                   bytes have to be here anyway to be loaded-to-prove, so the host never learns what a zip
                   is — it is handed one proved assembly and keeps it under its own hash.*@
                <label for="plugin-zip" class="form-label mb-1 mt-3" style="font-size: .85rem;">Or from a zip</label>
                <div class="d-flex gap-2 align-items-start flex-wrap">
                    <InputFile id="plugin-zip" class="form-control" style="min-width: 14rem;" accept=".zip" OnChange="ZipChosenAsync" disabled="@busy" data-testid="plugin-zip" />
                    <button type="button" class="btn btn-primary" style="flex-shrink: 0;" disabled="@(busy || zipBytes == null)" @onclick="InstallZipAsync" data-testid="plugin-zip-install">
                        @(busy ? "Checking…" : "Install the file")
                    </button>
                </div>

                @if (zipChosen != null)
                {
                    <div class="text-body-secondary mt-2" style="font-size: .8rem;" data-testid="plugin-zip-chosen">@zipChosen</div>
                }

                <div class="text-body-secondary mt-3" style="font-size: .8rem;">
                    Either way the manifest is checked before anything is kept — its permissions must sit under its own id —
                    and the plugin is loaded once, here and now, to prove it can be: finding a problem during install beats
                    finding it at the next boot.
                </div>

                <div class="text-body-secondary mt-2" style="font-size: .8rem;">
                    A zip is the plugin's folder: its <code>manifest.json</code> and the assembly the manifest's entry names,
                    beside it. <strong>An uploaded plugin is kept by this instance</strong>, because there is no URL to fetch
                    it from again — so it is not in a backup, and uninstalling it deletes the only copy here. Keep the zip.
                </div>
            </div>

            @*The file-system sibling of the audit below. Shown only when there is something to say —
               most instances install nothing from a file and should not carry an empty card about it.*@
            @if (sweep != null && (sweep.Held.Any(one => one.IsOrphan) || sweep.Missing.Count > 0))
            {
                <div class="card gdbv-tint p-3 mt-3" data-testid="plugin-files">
                    <h5 class="mb-2">Uploaded plugin code</h5>

                    @if (sweep.Missing.Count > 0)
                    {
                        @*THE HALF NOBODY EXPECTS. A record whose bytes are gone is a plugin that fails at
                           everyone's next boot with a 404 in its quarantine mark — and it is exactly what a
                           restored backup looks like, because the database is carried and this folder is
                           not.*@
                        <div class="alert alert-warning py-2 px-3 mb-2" data-testid="plugin-files-missing">
                            <strong>@string.Join(", ", sweep.Missing)</strong>
                            @(sweep.Missing.Count == 1 ? " is installed and its code is not here." : " are installed and their code is not here.")
                            They will fail at the next boot. Install them again from their zip, or uninstall them.
                        </div>
                    }

                    @if (sweep.Held.Any(one => one.IsOrphan))
                    {
                        <p class="text-body-secondary mb-2" style="font-size: .8rem;">
                            Assemblies this instance is holding that no installed plugin runs on. A plugin
                            uninstalled while the instance could not reach its own disk leaves one; so does
                            restoring a database next to a folder that moved on without it.
                        </p>

                        <table class="table table-sm mb-0" style="font-size: .85rem;" data-testid="plugin-files-table">
                            <tbody>
                                @foreach (var held in sweep.Held.Where(one => one.IsOrphan))
                                {
                                    <tr>
                                        <td><code>@held.Hash.Substring(0, 12)</code></td>
                                        <td class="text-body-secondary">@Kilobytes(held.Bytes)</td>
                                        <td class="text-body-secondary">@Arrived(held.At)</td>
                                        <td class="text-end">
                                            <button type="button" class="btn btn-outline-danger btn-sm py-0" disabled="@busy" @onclick="() => ForgetAsync(held)" data-testid="plugin-files-remove">Remove</button>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    }
                </div>
            }

            @*The uninstall prompt above answers "what would this plugin leave behind". This answers the
               question that has no plugin to ask it of: what is already in the graph that nothing claims.*@
            <div class="card gdbv-tint p-3 mt-3">
                <h5 class="mb-2">What is in the graph that nothing claims</h5>
                <p class="text-body-secondary mb-2" style="font-size: .8rem;">
                    Every vertex label in the instance graph, attributed to the plugin that owns it. A label with a dot is a
                    plugin's namespace; one without is the platform's, a bundled perspective's, or <strong>your own data,
                    which is left alone</strong>. What is left over is plugin-shaped and unclaimed — a plugin somebody
                    removed, or one that was never installed here. Read-only: nothing is deleted from this page.
                </p>

                <div>
                    <button type="button" class="btn btn-outline-secondary" disabled="@busy" @onclick="AuditOrphansAsync" data-testid="plugin-orphans">Audit the graph</button>
                </div>

                @if (orphans != null)
                {
                    @if (!orphans.InstanceGraphConfigured)
                    {
                        <p class="text-body-secondary mt-2 mb-0" style="font-size: .8rem;" data-testid="plugin-orphans-none">No instance graph is designated, so there is nothing to audit.</p>
                    }
                    else if (orphans.Error != null)
                    {
                        <p class="text-danger mt-2 mb-0" style="font-size: .8rem;" data-testid="plugin-orphans-error">@orphans.Error</p>
                    }
                    else
                    {
                        <div class="table-responsive">
                            <table class="table table-sm mt-2 mb-0" style="font-size: .85rem;" data-testid="plugin-orphans-table">
                                <thead>
                                    <tr><th>Namespace</th><th>Owner</th><th class="text-end">Vertices</th><th class="text-end">Edges</th><th>Labels</th></tr>
                                </thead>
                                <tbody>
                                    @foreach (var group in orphans.Groups)
                                    {
                                        <tr class="@(group.Owner == "Orphaned" ? "table-warning" : null)">
                                            <td>@group.Namespace</td>
                                            <td>@OwnerWord(group.Owner)</td>
                                            <td class="text-end">@group.Vertices</td>
                                            <td class="text-end">@(group.Owner == "Orphaned" ? group.Edges.ToString() : "—")</td>
                                            <td class="text-body-secondary">
                                                @string.Join(", ", group.Labels)
                                                @if (group.Sample.Count > 0)
                                                {
                                                    <div class="mt-1" style="font-size: .78rem;">for example @string.Join(", ", group.Sample)</div>
                                                }
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                }
            </div>
        }
    </div>
}
else
